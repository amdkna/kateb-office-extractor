# API
BASE_URL=https://officialoffice.web.kateb.ir
GEO_ENDPOINT=/api/marriageOffice/getNotarizationOfficesByGeo
SEARCH_URL=https://officialoffice.web.kateb.ir/search

# Authentication:
# auto    = try API directly; start Chrome only if direct access fails
# public  = API only, never open Chrome
# browser = always use Chrome and its reusable profile/session
AUTH_MODE=browser

# Optional manual cookies copied from Chrome DevTools.
# Normally leave this empty because browser mode uses the saved Chrome profile.
COOKIE_HEADER=

# Windows Chrome installation
CHROME_EXE=C:\Program Files\Google\Chrome\Application\chrome.exe

# Dedicated profile used by this program.
# Do not point this at your everyday Chrome profile while Chrome is running.
CHROME_PROFILE_DIR=./chrome-profile
HEADLESS=false

# SQLite database shared with the desktop data manager.
DATABASE_PATH=./data/office_data.sqlite3

# Greater Tehran metropolitan scan bounds (not the full province).
MIN_LAT=35.45
MAX_LAT=35.95
MIN_LNG=50.80
MAX_LNG=52.05

# The endpoint has an observed radius of approximately 2 km. The collector
# uses a staggered triangular grid with a conservative effective radius.
COVERAGE_RADIUS_KM=1.8

# Responses near this size get extra half-step probes in case the API is capped.
SATURATION_THRESHOLD=45

# Be polite to the server.
REQUEST_DELAY_SECONDS=1.0
REQUEST_TIMEOUT_SECONDS=30
MAX_RETRIES=3
VERIFY_SSL=true

USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/150.0.0.0 Safari/537.36
